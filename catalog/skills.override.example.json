{
  "version": 1,
  "skills": [
    {
      "id": "your-public-skill",
      "repo": "https://github.com/MlsMoon/your-public-skill",
      "engines": ["all"]
    }
  ],
  "plugins": [
    {
      "id": "your-public-plugin",
      "repo": "https://github.com/MlsMoon/your-public-plugin",
      "installName": "YourPublicPlugin",
      "installPath": "Assets/Plugins/YourPublicPlugin",
      "engines": ["unity"]
    }
  ],
  "packages": [
    {
      "id": "your-lan-package",
      "source": "lan",
      "repo": "ssh://<nas-host>:<git-path>",
      "host": "<nas-host>",
      "gitPath": "<git-path>",
      "installName": "YourLanPackage",
      "installPath": "Packages/YourLanPackage",
      "engines": ["unity"],
      "branches": [
        {
          "name": "main",
          "unity": "6000",
          "manifest": {
            "com.example.lan": "file:YourLanPackage/com.example.lan"
          }
        }
      ]
    }
  ]
}
