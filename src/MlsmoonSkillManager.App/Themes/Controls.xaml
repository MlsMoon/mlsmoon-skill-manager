    <Style x:Key="SettingsNav" TargetType="Button" BasedOn="{StaticResource FluentButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FluentIconFont}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkspaceCard" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="6,6,6,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSurface}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionFast}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionFast}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource MotionNormal}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionFast}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionFast}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource MotionFast}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="HoverLayer"
                                    CornerRadius="{StaticResource RadiusSurface}"
                                    Background="{DynamicResource OverlayHoverBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer"
                                    CornerRadius="{StaticResource RadiusSurface}"
                                    Background="{DynamicResource OverlayPressedBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <Border x:Name="Pip"
                                        DockPanel.Dock="Left"
                                        Width="3"
                                        CornerRadius="2"
                                        Margin="0,1,6,1"
                                        Background="Transparent"
                                        Opacity="0"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Pip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Pip" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,8,0,6"/>
    </Style>

    <Style x:Key="Segmented" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style TargetType="{x:Type ui:Badge}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Badge}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Neutral">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Plugin">
                <Setter Property="Background" Value="{DynamicResource PluginSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PluginBrush}"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Package">
                <Setter Property="Background" Value="{DynamicResource PackageSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PackageBrush}"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Universal">
                <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Unity">
                <Setter Property="Background" Value="{DynamicResource UnitySubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource UnityBrush}"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Godot">
                <Setter Property="Background" Value="{DynamicResource GodotSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource GodotBrush}"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Dev">
                <Setter Property="Background" Value="{DynamicResource DevBadgeBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DevBadgeTextBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="6,1"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Success">
                <Setter Property="Background" Value="{DynamicResource OkSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource WarnSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
            </Trigger>
            <Trigger Property="Appearance" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource BadSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ui:StatusLabel}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:StatusLabel}">
                    <TextBlock Text="{TemplateBinding Text}"
                               TextWrapping="Wrap"
                               Foreground="{TemplateBinding Foreground}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
                <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Accent">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Dev">
                <Setter Property="Foreground" Value="{DynamicResource DevBadgeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ui:Surface}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Surface}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSurface}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                       Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIfPresent}}">
                                <ContentPresenter DockPanel.Dock="Right"
                                                  Content="{TemplateBinding HeaderAction}"
                                                  Visibility="{Binding HeaderAction, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIfPresent}}"/>
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  TextBlock.FontWeight="SemiBold"
                                                  TextBlock.FontSize="14"
                                                  VerticalAlignment="Center"/>
                            </DockPanel>
                            <ContentPresenter DockPanel.Dock="Bottom"
                                              Content="{TemplateBinding Footer}"
                                              Margin="0,6,0,0"
                                              Visibility="{Binding Footer, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIfPresent}}"/>
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:FieldRow}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:FieldRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0"
                                          TextBlock.Foreground="{DynamicResource MutedBrush}"
                                          Content="{TemplateBinding Header}"/>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:ItemCard}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ItemCard}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSurface}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionNormal}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource MotionNormal}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="LoadStates">
                                <VisualState x:Name="Ready"/>
                                <VisualState x:Name="Loading"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="HoverLayer"
                                    CornerRadius="{StaticResource RadiusSurface}"
                                    Background="{DynamicResource OverlayHoverBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="LoadTrack"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource RadiusSurface}"
                                    Visibility="Collapsed"
                                    Padding="{TemplateBinding Padding}"
                                    MinHeight="56">
                                <DockPanel>
                                    <ProgressBar DockPanel.Dock="Bottom"
                                                 Height="8"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 IsIndeterminate="False"
                                                 Value="{TemplateBinding LoadProgress}"
                                                 Background="{DynamicResource SubtleBrush}"
                                                 Margin="0,8,0,0"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding LoadProgress, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}"/>
                                    <StackPanel>
                                        <TextBlock Text="{TemplateBinding Header}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource Caption}"
                                                   Text="{TemplateBinding LoadText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Grid x:Name="Body" Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <DockPanel>
                                    <ContentPresenter Content="{TemplateBinding Badge}"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"/>
                                    <ContentPresenter DockPanel.Dock="Right"
                                                      Content="{TemplateBinding Status}"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Text="{TemplateBinding Header}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="Desc"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource Caption}"
                                           Text="{TemplateBinding Description}"/>
                                <ContentPresenter Content="{TemplateBinding Content}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Top"
                                              Content="{TemplateBinding Actions}"/>
                        </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsNested" Value="True">
                            <Setter Property="Margin" Value="20,0,0,8"/>
                            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
                        </Trigger>
                        <Trigger Property="ShowDescription" Value="False">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="LoadTrack" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:NavRow}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:NavRow}">
                    <Grid>
                        <Button x:Name="Select"
                                Command="{TemplateBinding Command}"
                                CommandParameter="{TemplateBinding CommandParameter}"
                                Style="{StaticResource WorkspaceCard}">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{TemplateBinding Title}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="DetailText"
                                           Text="{TemplateBinding Detail}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource IconButton}"
                                Content="&#xE711;"
                                ToolTip="从列表移除"
                                Command="{TemplateBinding RemoveCommand}"
                                CommandParameter="{TemplateBinding RemoveCommandParameter}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Select" Property="Background" Value="{DynamicResource ThemeSelectedBrush}"/>
                            <Setter TargetName="Select" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Select" Property="Tag" Value="Active"/>
                        </Trigger>
                        <Trigger Property="DetailIsError" Value="True">
                            <Setter TargetName="DetailText" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{DynamicResource FluentIconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CaptionCloseTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CaptionCloseTextBrush}"/>
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
