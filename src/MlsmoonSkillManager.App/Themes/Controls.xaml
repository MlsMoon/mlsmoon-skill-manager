    <Style x:Key="StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StatusBarBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type ui:TitleBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource TitleBarBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:TitleBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="12,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Title}"
                                       TextTrimming="CharacterEllipsis"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="0,0,8,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Extra}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="PART_Minimize"
                                        Style="{StaticResource CaptionButton}"
                                        Content="&#xE921;"
                                        ToolTip="最小化"/>
                                <Button x:Name="PART_Maximize"
                                        Style="{StaticResource CaptionButton}"
                                        ToolTip="最大化">
                                    <TextBlock x:Name="MaxGlyph" Text="&#xE922;"/>
                                </Button>
                                <Button x:Name="PART_Close"
                                        Style="{StaticResource CaptionCloseButton}"
                                        Content="&#xE8BB;"
                                        ToolTip="关闭"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMaximized" Value="True">
                            <Setter TargetName="MaxGlyph" Property="Text" Value="&#xE923;"/>
                            <Setter TargetName="PART_Maximize" Property="ToolTip" Value="还原"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:AppDialog}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource OverlayDimBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Panel.ZIndex" Value="100"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="CardMaxWidth" Value="640"/>
        <Setter Property="CardMinWidth" Value="440"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:AppDialog}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="OpenStates">
                                <VisualState x:Name="Closed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Overlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionFast}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Card"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionFast}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardSlide"
                                                         Storyboard.TargetProperty="Y"
                                                         To="8" Duration="{StaticResource MotionFast}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Open">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Overlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource MotionNormal}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Card"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource MotionNormal}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardSlide"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="{StaticResource MotionNormal}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_Overlay"
                                Background="{TemplateBinding Background}"
                                Opacity="0"/>
                        <Border x:Name="Card"
                                MinWidth="{TemplateBinding CardMinWidth}"
                                MaxWidth="{TemplateBinding CardMaxWidth}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSurface}"
                                Padding="14"
                                Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CardSlide" Y="12"/>
                            </Border.RenderTransform>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button x:Name="PART_Close" AutomationProperties.AutomationId="DialogClose"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource CaptionButton}"
                                            Width="28"
                                            Height="28"
                                            Content="&#xE8BB;"
                                            ToolTip="关闭"/>
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{TemplateBinding Header}"/>
                                </DockPanel>
                                <StackPanel DockPanel.Dock="Bottom"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">
                                    <Button x:Name="PART_Secondary"
                                            Style="{StaticResource GhostButton}"
                                            Content="{TemplateBinding SecondaryText}"
                                            Visibility="{Binding SecondaryText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIfPresent}}"/>
                                    <Button x:Name="PART_Primary" AutomationProperties.AutomationId="DialogPrimary"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0"
                                            Content="{TemplateBinding PrimaryText}"/>
                                </StackPanel>
                                <ContentPresenter Content="{TemplateBinding Content}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
