<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Win11 Fluent light tokens, adapted from the public WinUI 3 / WPF-UI palette. -->
    <Color x:Key="BgColor">#F3F3F3</Color>
    <Color x:Key="SidebarColor">#F9F9F9</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardHoverColor">#F5F5F5</Color>
    <Color x:Key="LineColor">#E6E6E6</Color>
    <Color x:Key="TextColor">#1A1A1A</Color>
    <Color x:Key="MutedColor">#5D5D5D</Color>
    <Color x:Key="AccentColor">#005FB8</Color>
    <Color x:Key="AccentSubtleColor">#1A005FB8</Color>
    <Color x:Key="OkColor">#0F7B0F</Color>
    <Color x:Key="WarnColor">#9D5D00</Color>
    <Color x:Key="BadColor">#C42B1C</Color>
    <Color x:Key="FieldColor">#FFFFFF</Color>
    <Color x:Key="GhostColor">#E8E8E8</Color>
    <Color x:Key="SubtleColor">#F0F0F0</Color>
    <Color x:Key="SubtlePressedColor">#E6E6E6</Color>
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="ThemeSelectedColor">#E6F2FB</Color>
    <Color x:Key="PluginColor">#018574</Color>
    <Color x:Key="PluginSubtleColor">#1A018574</Color>
    <Color x:Key="ChipColor">#F0F0F0</Color>
    <Color x:Key="OverlayHoverColor">#14000000</Color>
    <Color x:Key="OverlayPressedColor">#1A000000</Color>
    <Color x:Key="DevBadgeColor">#E65100</Color>
    <Color x:Key="DevBadgeTextColor">#FFFFFF</Color>
    <Color x:Key="TitleBarColor">#F3F3F3</Color>
    <Color x:Key="CaptionHoverColor">#E8E8E8</Color>
    <Color x:Key="CaptionCloseColor">#C42B1C</Color>
    <Color x:Key="CaptionCloseTextColor">#FFFFFF</Color>
    <Color x:Key="OverlayDimColor">#66000000</Color>
    <Color x:Key="StatusBarColor">#ECECEC</Color>
    <Color x:Key="UnityColor">#0B6BCB</Color>
    <Color x:Key="UnitySubtleColor">#1A0B6BCB</Color>
    <Color x:Key="GodotColor">#0F7B6C</Color>
    <Color x:Key="GodotSubtleColor">#1A0F7B6C</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}"/>
    <SolidColorBrush x:Key="GhostBrush" Color="{StaticResource GhostColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="{StaticResource SubtlePressedColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="ThemeSelectedBrush" Color="{StaticResource ThemeSelectedColor}"/>
    <SolidColorBrush x:Key="PluginBrush" Color="{StaticResource PluginColor}"/>
    <SolidColorBrush x:Key="PluginSubtleBrush" Color="{StaticResource PluginSubtleColor}"/>
    <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}"/>
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="{StaticResource OverlayHoverColor}"/>
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="{StaticResource OverlayPressedColor}"/>
    <SolidColorBrush x:Key="DevBadgeBrush" Color="{StaticResource DevBadgeColor}"/>
    <SolidColorBrush x:Key="DevBadgeTextBrush" Color="{StaticResource DevBadgeTextColor}"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="{StaticResource CaptionHoverColor}"/>
    <SolidColorBrush x:Key="CaptionCloseBrush" Color="{StaticResource CaptionCloseColor}"/>
    <SolidColorBrush x:Key="CaptionCloseTextBrush" Color="{StaticResource CaptionCloseTextColor}"/>
    <SolidColorBrush x:Key="OverlayDimBrush" Color="{StaticResource OverlayDimColor}"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="{StaticResource StatusBarColor}"/>
    <SolidColorBrush x:Key="UnityBrush" Color="{StaticResource UnityColor}"/>
    <SolidColorBrush x:Key="UnitySubtleBrush" Color="{StaticResource UnitySubtleColor}"/>
    <SolidColorBrush x:Key="GodotBrush" Color="{StaticResource GodotColor}"/>
    <SolidColorBrush x:Key="GodotSubtleBrush" Color="{StaticResource GodotSubtleColor}"/>
</ResourceDictionary>
